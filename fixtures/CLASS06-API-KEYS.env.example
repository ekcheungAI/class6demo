# CLASS06-API-KEYS.env.example — 只有名，冇值。
# 真檔由老師另外派（private-credentials/CLASS06-API-KEYS.env），唔喺 ZIP、唔入 Git、唔貼 chat。
# Codex 只會「合併」呢啲名入本機 env；唔會顯示值。

# 搵靈感（第一幕）— 班房會 call
FIRECRAWL_API_KEY=          # ② 讀正文：/v2/scrape（Exa 死先做 ① /v2/search）
TAVILY_API_KEY=             # ③ 交叉核對：只核 claim_risk 中／高
EXA_API_KEY=                # ① 搵候選：語意搜尋，每輪 1 次 ≤8 結果

# 生成（沿用第五堂）
TOPAPIS_API_KEY=            # 三份工共用一條：打分（第一幕）· 改寫（第二幕）· 生圖（第五幕）
                            # 模板變數名係 TOAPI_API_KEY；100 credits 三樣一齊食

# 課後／第七堂先用 — 今日唔 call
TIKHUB_API_KEY=             # IG / YouTube / Reddit 深度資料
MINIMAX_API_KEY=            # 另一個 LLM

# 你自己嘅（唔係老師派）
THREADS_USER_ACCESS_TOKEN=
THREADS_USER_ID=
UPLOAD_POST_API_KEY=        # Pro track 先有
CRON_SECRET=                # 第六幕老師示範；功課先用
