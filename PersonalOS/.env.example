# .env.example — 只有變數名，冇值。
#
# 呢個檔係 `npm run setup:env` 同 `npm run check:env` 嘅模板：
#   setup:env  照住呢個清單開一個 .env.local（已有嘅值唔會被覆蓋）
#   check:env  照住呢個清單報邊個已設定、邊個未設定（永遠唔會印出值）
#   check:keys 課前 Key 檢查：每條 key 一個免費只讀呼叫，報通唔通同下一步
#              （同 Connections 頁「課前 Key 檢查」面板係同一個檢查；唔印值）
#
# 真 key 只住三個地方：本機 .env.local、Vercel Environment Variables、
# 老師私下派嗰個 env 檔。唔入 Git、唔貼 chat、唔貼截圖。

# ── Supabase（第五堂已接）────────────────────────────────────────────
# 呢兩條係 NEXT_PUBLIC_，即係會去到瀏覽器——所以只可以放公開嗰兩條。
# 任何 service role key 都唔准用 NEXT_PUBLIC_ 開頭。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 生成（老師派；三份工共用一條）────────────────────────────────────
# 打分、改寫（deepseek-v4-flash）、生圖，全部食呢一條同一個額度。
# 老師派嘅檔如果寫 TOPAPIS_API_KEY，部機讀嘅係下面呢個名。
TOAPI_API_KEY=
STUDENT_TOAPI_BUDGET_CREDITS=100

# ── 功能開關 ──────────────────────────────────────────────────────
# 唔設成 1，/api/feed/rewrite 會回 403「此版本尚未開放生成」，
# 第二幕（Rewrite）同之後每一步都跑唔郁。
STUDENT_TEACHER_PREVIEW=1

# ── 搵靈感（第一幕，老師派）──────────────────────────────────────────
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# ── 出街（你自己嘅，唔係老師派）──────────────────────────────────────
# Threads：出帖只需要呢兩條。App secret 唔需要（佢只係用嚟換長期 token）。
THREADS_USER_ACCESS_TOKEN=
THREADS_USER_ID=
# Upload-Post：Pro track 先有。喺 app.upload-post.com/api-keys 撳 Create。
UPLOAD_POST_API_KEY=
# 兩條 base URL 平時唔使郁（留空＝行官方）。只有跑本地 mock 測試先會指去第二度。
THREADS_BASE=
UPLOAD_POST_BASE=

# ── 課後／第七堂先用 ───────────────────────────────────────────────
TIKHUB_API_KEY=
TIKHUB_FEED_APPROVED=
MINIMAX_API_KEY=

# ── 進階（平時唔使郁）────────────────────────────────────────────────
# 本機 API 只接受呢啲來源；留空 = 只接受本機。
PERSONALOS_ALLOWED_ORIGINS=
# 本機資料寫落邊個資料夾。留空 = 預設。
STUDENT_OUTPUT_DIR=
# 功課用：cron 觸發時要帶嘅密碼，自己生成一串長字串。
CRON_SECRET=
